meta {
  name: Filter Customer Stories by Industry
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/customerstories
  body: none
}

query {
  industry: LEAGUES_AND_FEDERATIONS
  solutions: GAMING_AND_FAN_LOYALTY
  page: 1
  limit: 10
}

docs {
  name: Filter Customer Stories API
  desc: Get customer stories filtered by industry and solutions

  params {
    industry: Industry filter (e.g., LEAGUES_AND_FEDERATIONS, TEAM, PUBLISHERS, GAMING_OPERATORS)
    solutions: Solution filter (e.g., GAMING_AND_FAN_LOYALTY, DIGITAL_PLATFORMS, DESIGN_AND_VIDEO_PRODUCTION)
    page: Page number (default: 1)
    limit: Items per page (default: 10, max: 50)
  }
} 
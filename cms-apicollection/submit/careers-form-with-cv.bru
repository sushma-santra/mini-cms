meta {
  name: Submit Career Form with CV
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/submit
  body: multipartForm
  auth: none
}

body:multipart-form {
  module_name: careers
  first_name: John
  last_name: Doe
  email: john.doe@example.com
  job_title: Software Developer
  captcha: <recaptcha-token>
  cv_file: @file(/path/to/resume.pdf)
}

docs {
  name: Career Form Submission API with CV Upload
  desc: |
    Submit a career application form with CV file upload. Requires reCAPTCHA verification.
    Supports PDF, DOC, and DOCX file formats with maximum 10MB file size.
    
    File Upload Requirements:
    - Supported formats: PDF, DOC, DOCX
    - Maximum file size: 10MB
    - Field name: cv_file
    
    Response:
    - 200: Submission successful (CV uploaded to S3)
    - 400: Validation error, invalid captcha, or file validation error
    - 500: Server error or file upload failure

  params:
    module_name: Type of form submission (required, must be "careers")
    first_name: Applicant's first name (required)
    last_name: Applicant's last name (required)
    email: Valid email address (required)
    job_title: Position title applying for (optional)
    cv_file: CV file upload (optional, PDF/DOC/DOCX, max 10MB)
    captcha: Valid reCAPTCHA token (required)
} 
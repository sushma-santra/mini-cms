generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(AUTHOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  @@map("users")
}

model Post {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  fullText    String      // Changed from 'content' for consistent naming
  excerpt     String?
  caption     String?     // New field: Short caption
  description String?     // New field: Description
  externalLinks String?   // New field: External links
  seoTitle    String?
  seoDescription String?
  featuredImage String?
  images      Json?       // Store multiple images as JSON array
  status      PostStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  tags Tag[]

  @@map("posts")
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@map("categories")
}

model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@map("tags")
}

model EbookSubmission {
  id               String   @id @default(cuid())
  firstName        String   @db.VarChar(100)
  lastName         String   @db.VarChar(100)
  organisationName String   @db.VarChar(200)
  country         String   @db.VarChar(100)
  email           String   @db.VarChar(255)
  privacyPolicy   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ebook_submissions")
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscriptions")
}

model ContactSubmission {
  id                  String   @id @default(cuid())
  firstName           String   @db.VarChar(100)
  lastName            String   @db.VarChar(100)
  organisation        String   @db.VarChar(200)
  typeOfOrganisation  String   @db.VarChar(100)
  country             String   @db.VarChar(100)
  phoneNumber         String   @db.VarChar(50)
  email               String   @db.VarChar(255)
  message             String   @db.Text
  privacyPolicy       Boolean? @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("contact_submissions")
}

enum UserRole {
  ADMIN
  AUTHOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
} 
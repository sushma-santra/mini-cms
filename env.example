# Database
DATABASE_URL="postgresql://username:password@localhost:5432/simple_cms"

# Redis (optional - for caching)
REDIS_URL="redis://localhost:6379"

# AWS S3 Configuration (using AWS profiles)
# The application will use AWS profiles from ~/.aws/credentials
# Set AWS_PROFILE if you want to use a specific profile (defaults to 'default')
AWS_PROFILE="default"  # Optional: specify profile name
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-s3-bucket-name"

# reCAPTCHA Configuration
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# NextAuth Configuration
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"

# CORS Configuration
# Primary allowed origin for CORS requests
CORS_ALLOWED_ORIGIN="https://your-frontend-domain.com"
# Alternative: use NEXT_PUBLIC_FRONTEND_URL if you prefer
# NEXT_PUBLIC_FRONTEND_URL="https://your-frontend-domain.com"

# Additional allowed origins (comma-separated)
# CORS_ADDITIONAL_ORIGINS="https://staging.your-domain.com,https://dev.your-domain.com"

# Application
NODE_ENV="development" 